{
  "name": "rename-studio",
  "private": true,
  "version": "1.2.0-alpha21",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "version:sync": "node scripts/version.mjs",
    "icon:build": "node scripts/gen-icons.mjs",
    "version:check": "node scripts/check-version.mjs",
    "version:selftest": "node scripts/check-version.mjs --self-test",
    "tokens:check": "node scripts/check-design-tokens.mjs",
    "tokens:update": "node scripts/check-design-tokens.mjs --update",
    "tokens:selftest": "node scripts/check-design-tokens.mjs --self-test",
    "tauri:build": "node scripts/version.mjs && tauri build",
    "test:corpus": "node scripts/gen-test-corpus.mjs",
    "test:core": "cargo test --manifest-path src-tauri/renomio-core/Cargo.toml",
    "test:e2e": "node e2e/run.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:drop": "node scripts/test-drop-gate.mjs",
    "test:preview": "node scripts/test-preview-finalize.mjs",
    "test:history": "node scripts/test-rule-history.mjs",
    "test:regex": "node scripts/test-regex-dialect.mjs",
    "test:regex:real": "node scripts/test-regex-real.mjs",
    "test:case": "node scripts/test-case-protect.mjs",
    "test:css": "node scripts/test-css-orphans.mjs",
    "test:meta": "node scripts/test-meta-fields.mjs",
    "test:move": "node scripts/test-move.mjs",
    "test:ext": "node scripts/test-ext.mjs",
    "test:del": "node scripts/test-del.mjs",
    "test:iptc": "node scripts/test-iptc.mjs",
    "test:platform": "node scripts/test-platform.mjs --require-probe",
    "test:datadir": "node scripts/test-datadir.mjs --require-probe",
    "test:update": "node scripts/test-update.mjs --require-probe",
    "test:ini": "node scripts/test-ini.mjs --require-probe",
    "test:repair": "node scripts/test-repair.mjs",
    "test:columns": "node scripts/test-columns.mjs",
    "test:filter": "node scripts/test-filter.mjs",
    "test:map": "node scripts/test-map.mjs",
    "test:bundle": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-bundle.ps1",
    "foundation:build": "tsc -p packages/foundation/tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
